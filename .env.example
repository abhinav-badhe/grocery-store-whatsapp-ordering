# ==============================================================================
# Grocery Store Monorepo — Local Root Environment Template
# ==============================================================================
# IMPORTANT:
# This file is an illustrative template for local developer workspace defaults.
# DO NOT store real credentials, secrets, tokens, or production URLs in this file.
#
# Service-specific environment variables and secrets belong strictly in each
# individual service workspace directory (e.g., apps/identity-service/.env.example)
# and are NOT shared through this root file.
#
# Real .env files are excluded from source control by .gitignore.
# ==============================================================================

# Node runtime environment (development | test | production)
NODE_ENV=development

# Service HTTP port binding (Render injects dynamic PORT at runtime)
PORT=3000

# Logging output level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Local Development Infrastructure (docker-compose.yml)
# Binds strictly to loopback (127.0.0.1). Do NOT use production credentials.
# These values are INSECURE local-only development defaults.
# Real .env files are git-ignored. Never commit real credentials to source control.
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=grocerystore
POSTGRES_PORT=5432

# RabbitMQ local development credentials
# NOTE: Do NOT use the default 'guest' account for service-to-service communication
# because RabbitMQ restricts 'guest' access to loopback (localhost) by default.
# Inter-service connections inside the Compose network connect from container IPs
# and must authenticate using this dedicated local development user.
RABBITMQ_DEFAULT_USER=grocery_dev
RABBITMQ_DEFAULT_PASS=grocery_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PORT=6379
