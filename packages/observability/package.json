{
  "name": "@grocery/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Shared structured JSON logging, correlation context, and secret redaction",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/**/*.test.ts"
  },
  "dependencies": {
    "@grocery/config": "workspace:*",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@grocery/tsconfig": "workspace:*"
  }
}
