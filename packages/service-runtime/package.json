{
  "name": "@grocery/service-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Shared HTTP service runtime factory, health endpoints, and worker lifecycle management",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/**/*.test.ts"
  },
  "dependencies": {
    "@grocery/api-contracts": "workspace:*",
    "@grocery/config": "workspace:*",
    "@grocery/observability": "workspace:*"
  },
  "devDependencies": {
    "@grocery/tsconfig": "workspace:*",
    "@types/node": "^22.13.5"
  }
}
